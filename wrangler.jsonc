{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xaut-grade-dashboard",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "UPSTREAM_ORIGIN": "https://jwgl.xaut.edu.cn",
    "PUBLIC_APP_URL": "https://xaut-grade-dashboard.pages.dev",
    "REMINDER_FROM": "XAUT 考试提醒 <reminders@xautjw.cn>"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS_DB",
      "database_name": "xaut-exam-reminders",
      "database_id": "d8145ab6-faf3-40e3-bcae-44b88e3126ee",
      "migrations_dir": "migrations"
    }
  ]
}

