{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xaut-exam-reminders",
  "main": "src/reminder-worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_APP_URL": "https://xaut-grade-dashboard.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS_DB",
      "database_name": "xaut-exam-reminders",
      "database_id": "d8145ab6-faf3-40e3-bcae-44b88e3126ee",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
